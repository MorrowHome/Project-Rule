        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;stateDiagram-v2\n    [*] --&gt; Active\n\n    state \&quot;Active 可行动状态\&quot; as Active {\n        [*] --&gt; Idle\n        state \&quot;Idle 地面决策\&quot; as Idle\n        state \&quot;Fly 空中飞行\&quot; as Fly\n        Idle --&gt; Fly : 距离远 / 需要移动\n        Fly --&gt; Idle : 进入攻击距离 / 决策\n    }\n\n    state \&quot;Slash 劈砍\&quot; as Slash\n    state \&quot;Shake 甩毛\&quot; as Shake\n    state \&quot;Roar 大叫\&quot; as Roar\n    state \&quot;WingSpread 大展翅膀\&quot; as WingSpread\n    state \&quot;Point 前指\&quot; as Point\n    state \&quot;Dash 冲刺\&quot; as Dash\n    state \&quot;Hurt 受击\&quot; as Hurt\n\n    Active --&gt; Slash : 近身\n    Active --&gt; Shake : 主动甩毛\n    Active --&gt; Roar : 二阶段起 召唤\n    Active --&gt; WingSpread : 二阶段起 满蓝规则\n    Active --&gt; Point : 二阶段起 有召唤物且3秒后\n    Active --&gt; Dash : 三阶段 全屏冲刺\n    Active --&gt; Hurt : 受到玩家攻击 且 CD好\n\n    Slash --&gt; Active : 动画结束\n    Shake --&gt; Active : 动画结束\n    Roar --&gt; Active : 动画结束\n    WingSpread --&gt; Active : 动画结束\n    Point --&gt; Active : 动画结束\n    Dash --&gt; Active : 动画结束\n\n    Hurt --&gt; Shake : 受击动画结束（被动甩毛）\n    Shake --&gt; Active : 甩毛结束&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="nBTZ22ri-zy5Kc80QQqW-239">
