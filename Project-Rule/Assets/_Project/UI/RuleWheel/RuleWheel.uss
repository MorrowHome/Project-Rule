.wheel-screen {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    color: #20201d;
    -unity-font-definition: url("project://database/Assets/_Project/UI/Fonts/P4ChineseFont.asset");
}
.wheel-root { position: absolute; width: 260px; height: 410px; }
.rule-fan { position: absolute; left: 0; top: 0; width: 240px; height: 410px; }
.wheel-word {
    position: absolute;
    width: 88px; height: 36px;
    margin: 0; padding: 0;
    -unity-text-align: middle-center;
    font-size: 20px;
    -unity-font-style: bold;
    white-space: nowrap;
    color: #20201d;
}
.wheel-word.long-word { font-size: 16px; }
.wheel-word.selected { color: #efede1; }
.wheel-word.unavailable { color: #62625c; }
.wheel-word.unavailable.selected { color: #20201d; }
.selected-token {
    position: absolute;
    left: -12px; top: 184px;
    min-width: 80px; height: 42px;
    margin: 0; padding: 5px 8px;
    background-color: #20201d;
    color: #efede1;
    -unity-text-align: middle-center;
    font-size: 20px;
    -unity-font-style: bold;
}
.wheel-feedback {
    position: absolute; left: 40px; bottom: 0;
    margin: 0; padding: 0;
    font-size: 16px;
    color: #20201d;
}
.hidden { display: none; }
