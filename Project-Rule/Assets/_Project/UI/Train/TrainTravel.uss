.train-screen {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    align-items: center; justify-content: center;
    background-color: rgba(8, 10, 14, 0.45);
    color: #f0eee5; font-size: 30px;
    -unity-font-definition: url("project://database/Assets/_Project/UI/Fonts/P4ChineseFont.asset");
}
.train-panel {
    min-width: 640px; padding: 22px 26px;
    background-color: rgba(16, 20, 24, 0.96);
}
.train-header {
    flex-direction: row; justify-content: space-between; align-items: center;
    margin-bottom: 14px;
}
.train-title { font-size: 38px; -unity-font-style: bold; }
.train-close {
    font-size: 26px; padding: 6px 18px; margin-left: 18px;
    color: #f0eee5; background-color: rgba(60, 66, 74, 0.95);
    border-width: 0;
}
.train-close:hover { background-color: #6c5a8a; }
.train-row {
    flex-direction: row; justify-content: space-between;
    padding: 8px 14px; margin-bottom: 6px;
    background-color: rgba(40, 46, 54, 0.9);
}
.train-row-selected { background-color: #6c5a8a; }
.train-row-current { opacity: 0.45; }
.train-row-locked { opacity: 0.35; }
.train-name { font-size: 30px; }
.train-state { font-size: 24px; color: #c5c4b6; }
.train-hint { margin-top: 14px; font-size: 24px; color: #c5c4b6; }
.train-hidden { display: none; }
